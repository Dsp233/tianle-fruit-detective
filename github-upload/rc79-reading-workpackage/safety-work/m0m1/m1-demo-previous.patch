+   const inTray=state.tray.length, remaining=state.ones-inTray;
+   return inTray===10
+    ? `框里正好10个一，盘里还有${remaining}个一。下一步把框里的这10个一捆成一根十棒。`
+    : `框里有${inTray}个一，盘里还有${remaining}个一。再移${10-inTray}个一就满框。`;
+  }
+  if(action==='workBundle'){
+   const total=task.initialTens*10+task.initialOnes;
+   return `捆前：${task.initialTens}个十和${task.initialOnes}个一。捆后：${state.tens}个十和${state.ones}个一。总数两次都是${total}。`;
+  }
+ }
  if(/Undo|Return|Unplace|Uncopy/.test(action))return '撤销时放回同一批原对象，数量和身份都可以核对。';
